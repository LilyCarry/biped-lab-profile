#!/usr/bin/env bash
# pre-push 钩子：保护 Netlify 免费额度
#
# 背景：推送到 main 会同时触发 GH Pages / Netlify / CF Pages 的生产部署。
#       Netlify 免费档每次生产部署扣 15 credits，每月只有 300（≈20 次）。
#       用完 Netlify 直接停站，要等计费周期重置。
#       分支部署（push 到非 main 分支）在 Netlify 上是免费的。
#
# 行为：
#   推送到 main 且剩余额度 > 2 次  -> 打印警告，放行
#   推送到 main 且剩余额度 <= 2 次 -> 阻止，除非设 CONFIRM_MAIN_PUSH=1
#
# 启用：git config core.hooksPath .githooks
# 临时绕过：CONFIRM_MAIN_PUSH=1 git push origin HEAD:main
set -uo pipefail

CYCLE_START="${CYCLE_START:-2026-10-10}"
BUDGET=300
COST_DEPLOY=15

pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && pushing_main=1
done

[ "$pushing_main" = 0 ] && exit 0

count=$(git log --oneline --since="$CYCLE_START 00:00" origin/main 2>/dev/null | wc -l | tr -d ' ')
[ -z "$count" ] && count=0
credits=$((count * COST_DEPLOY))
left=$(( (BUDGET - credits) / COST_DEPLOY ))
[ "$left" -lt 0 ] && left=0

echo ""
echo "┌─ 推送目标包含 main ─────────────────────────────────"
echo "│ 这会触发 3 个源的生产部署；Netlify 每次扣 $COST_DEPLOY credits"
echo "│ 本周期已用 $credits / $BUDGET credits（$count 次部署），剩余约 $left 次"
echo "└─────────────────────────────────────────────────────"

if [ "$left" -le 2 ]; then
  if [ "${CONFIRM_MAIN_PUSH:-0}" != "1" ]; then
    echo ""
    echo "  ✗ 剩余额度不足 3 次，已阻止推送。"
    echo "    确实要推：CONFIRM_MAIN_PUSH=1 git push origin HEAD:main"
    echo "    建议：把迭代放到分支上（Netlify 分支部署免费），完工再合并。"
    exit 1
  fi
  echo "  ! CONFIRM_MAIN_PUSH=1，放行（额度将所剩无几）"
fi
echo ""
exit 0
